generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  exams        Exam[]
}

model Exam {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       String
  totalMarks    Int
  numQuestions  Int
  difficulty    String    // EASY | MEDIUM | HARD | MIXED
  timeLimit     Int?      // minutes
  topics        String    // JSON array stored as string
  questionTypes String    // JSON array stored as string
  content       String    // Full ExamDocument JSON
  status        String    @default("DRAFT") // DRAFT | SAVED | PUBLISHED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}
